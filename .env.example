# متغيرات البيئة - انسخ هذا الملف إلى .env وعدّل القيم

# مفتاح سري للتطبيق (غيره في الإنتاج)
SECRET_KEY=your-secret-key-change-in-production

# بيئة التشغيل
FLASK_ENV=development

# رابط قاعدة البيانات
# للتطوير المحلي، استخدم SQLite
DATABASE_URL=sqlite:///ishtar_portal.db

# للإنتاج، استخدم PostgreSQL أو MySQL
# DATABASE_URL=postgresql://user:password@localhost/ishtar_portal
# DATABASE_URL=mysql+pymysql://user:password@localhost/ishtar_portal

# رقم المنفذ
PORT=5000

# تفاصيل البريد الإلكتروني (للإشعارات المستقبلية)
# MAIL_SERVER=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=your-email@gmail.com
# MAIL_PASSWORD=your-password

# تفاصيل الدفع (للمستقبل)
# PAYMENT_API_KEY=your-payment-api-key
# PAYMENT_SECRET=your-payment-secret
